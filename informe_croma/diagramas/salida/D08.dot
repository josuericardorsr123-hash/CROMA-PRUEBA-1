digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Vehículos y tránsito: RUNT y SIMIT</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D08</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Compuerta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#FCF5E6"; color="#F1CA73"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Placa (y documento</B><BR/>del propietario)<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R10</I></FONT>>];
    "L" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Base legal para el titular?</B>>];
  }
  subgraph cluster_1 {
    label=<<B>Consulta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Qué necesitas?</B>>];
    "VP" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>runt_vehicle_by_plate</B><BR/>placa + documento<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "VH" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>runt_vehicle_history_</B><BR/>by_plate<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "CD" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>runt_citizen_by_</B><BR/>document<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "CP" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>runt_citizen_by_</B><BR/>plate<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "SI" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>simit_account_status</B><BR/>placa o documento<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "J" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Trabajo asíncrono</B><BR/>en vivo · 10 créditos<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R05 · R02</I></FONT>>];
  }
  subgraph cluster_2 {
    label=<<B>Resultado</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F1F7"; color="#73B1D5"; penwidth=1.0;
    "V" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿found?</B>>];
    "NF" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>found:false</B>>];
    "BE" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>SOAT · RTM · prendas</B><BR/>blindaje · multas>];
    "OUT" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Suscripción, crédito</B><BR/>o cobranza>];
  }
  "NO" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>No consultar</B><BR/>datos personales>];
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>5xx upstream_error</B>>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: decisión</B><BR/>vehicular>];
  "FER" [shape=ellipse, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Fin: abstención</B><BR/>o reintento>];
  { rank=same; "S"; }
  { rank=same; "L"; }
  { rank=same; "D1"; "NO"; }
  { rank=same; "VP"; "VH"; "CD"; "CP"; }
  { rank=same; "SI"; }
  { rank=same; "J"; }
  { rank=same; "V"; "E"; }
  { rank=same; "NF"; "BE"; "FER"; }
  { rank=same; "OUT"; }
  { rank=same; "FOK"; }
  "S" -> "L" [color="#404040", style="solid", penwidth=1.1];
  "L" -> "D1" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "L" -> "NO" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "D1" -> "VP" [color="#404040", style="solid", penwidth=1.1, label=< ficha >, fontcolor="#262626"];
  "D1" -> "VH" [color="#404040", style="solid", penwidth=1.1, label=< historial >, fontcolor="#262626"];
  "D1" -> "SI" [color="#404040", style="solid", penwidth=1.1, label=< multas >, fontcolor="#262626"];
  "D1" -> "CD" [color="#404040", style="solid", penwidth=1.1, label=< conductor >, fontcolor="#262626", minlen=2];
  "D1" -> "CP" [color="#404040", style="solid", penwidth=1.1, label=< propietario >, fontcolor="#262626", minlen=2];
  "VP" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "VH" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "CD" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "CP" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "SI" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "J" -> "V" [color="#404040", style="solid", penwidth=1.1, label=< completed >, fontcolor="#262626"];
  "J" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< falla >, fontcolor="#D55E00"];
  "V" -> "NF" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "V" -> "BE" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "NF" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "BE" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "OUT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "NO" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "E" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD></TD><TD></TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
  "FER" -> "__leyenda" [style=invis];
}