digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Fuentes sectoriales: INVIMA, ANM y SIATA</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D14</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Consulta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Verificación</B><BR/>sectorial>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Sector?</B>>];
    "IN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>invima_registrations ·</B><BR/>medicines (CUM, ATC)<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "AN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>anm_notices_search</B><BR/>→ anm_notice<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R08 · R19</I></FONT>>];
    "SI" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>siata_geoportal_*</B><BR/>aire · lluvia · ríos<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "IV" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Vigente y CUM activo?</B>>];
    "QS" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Valor −999?</B>>];
  }
  subgraph cluster_1 {
    label=<<B>Resultado</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F1F7"; color="#73B1D5"; penwidth=1.0;
    "OKV" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Producto</B><BR/>habilitado>];
    "NOT" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Estados, avisos</B><BR/>y edictos>];
    "AMB" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Lectura válida</B><BR/>con ICA>];
  }
  "AL" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Alerta: vencido</B><BR/>o inactivo>];
  "DS" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Descartar lectura</B><BR/>inválida>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: verificación</B><BR/>sectorial>];
  { rank=same; "S"; }
  { rank=same; "D1"; }
  { rank=same; "IN"; "AN"; "SI"; }
  { rank=same; "IV"; "QS"; "NOT"; }
  { rank=same; "OKV"; "AMB"; "AL"; "DS"; }
  { rank=same; "FOK"; }
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "IN" [color="#404040", style="solid", penwidth=1.1, label=< sanitario >, fontcolor="#262626"];
  "D1" -> "AN" [color="#404040", style="solid", penwidth=1.1, label=< minero >, fontcolor="#262626"];
  "D1" -> "SI" [color="#404040", style="solid", penwidth=1.1, label=< ambiental >, fontcolor="#262626"];
  "IN" -> "IV" [color="#404040", style="solid", penwidth=1.1];
  "IV" -> "OKV" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "IV" -> "AL" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "AN" -> "NOT" [color="#404040", style="solid", penwidth=1.1];
  "SI" -> "QS" [color="#404040", style="solid", penwidth=1.1];
  "QS" -> "DS" [color="#D55E00", style="solid", penwidth=1.4, label=< sí >, fontcolor="#D55E00"];
  "QS" -> "AMB" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "OKV" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "NOT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "AMB" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "AL" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "DS" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
}