digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Trámites del Estado y herramientas web</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D15</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Consulta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Duda sobre un trámite</B><BR/>o una página pública>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Dónde está la información?</B>>];
    "SU" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>suit_procedures_search</B><BR/>→ suit_procedure<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R19</I></FONT>>];
    "GP" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>gov_pages_search</B><BR/>→ gov_pages_page<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R19</I></FONT>>];
    "X" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#CC79A7", color="#1A1A1A", fontcolor="#000000", label=<<B>extract_* ·</B><BR/>generate_json<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R17 · R04</I></FONT>>];
    "RS" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#CC79A7", color="#1A1A1A", fontcolor="#000000", label=<<B>research ·</B><BR/>web_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R09</I></FONT>>];
    "D2" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Página extraíble?</B>>];
    "OUT" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Respuesta ciudadana</B><BR/>con enlace oficial>];
    "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Internal error</B><BR/>(gov.co, T52)>];
    "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: orientación</B><BR/>verificable>];
  }
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "SU" [color="#404040", style="solid", penwidth=1.1, label=< SUIT >, fontcolor="#262626"];
  "D1" -> "GP" [color="#404040", style="solid", penwidth=1.1, label=< sitio entidad >, fontcolor="#262626"];
  "D1" -> "X" [color="#404040", style="solid", penwidth=1.1, label=< otra página >, fontcolor="#262626"];
  "D1" -> "RS" [color="#404040", style="solid", penwidth=1.1, label=< pregunta abierta >, fontcolor="#262626"];
  "X" -> "D2" [color="#404040", style="solid", penwidth=1.1];
  "D2" -> "OUT" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D2" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "E" -> "SU" [color="#332288", style="bold", penwidth=1.8, label=< remite a >, fontcolor="#332288", constraint=false];
  "SU" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "GP" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "RS" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "OUT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#CC79A7"></TD><TD ALIGN="LEFT">Modelo de IA / agente</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD ALIGN="CENTER"><FONT COLOR="#332288"><B>——→</B></FONT></TD><TD ALIGN="LEFT">remite a</TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
}