digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Estadística oficial: DANE, BanRep, DNP, ICFES, MinEducación</B><BR/><FONT POINT-SIZE="9">Pipeline (DAG) · v1.0 · 2026-10-12 · D13</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Fuentes</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Pregunta socio o</B><BR/>macroeconómica>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Ámbito?</B>>];
    "BR" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>banrep_series_search</B><BR/>→ banrep_series<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "BI" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>banrep_research_</B><BR/>publications_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R19</I></FONT>>];
    "DN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>dane_poverty · labour_</B><BR/>market · ipm · census<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "TD" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>terridata_indicators</B><BR/>→ series · ranking<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "ED" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>icfes_saber11_* ·</B><BR/>mineducacion<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
  }
  subgraph cluster_1 {
    label=<<B>Preparación</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EBE9F3"; color="#8F85BE"; penwidth=1.0;
    "DV" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Normalizar territorio</B><BR/>DIVIPOLA 2 o 5 dígitos<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R18</I></FONT>>];
    "AS" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿as_of y periodicidad?</B>>];
    "OUT" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Tablero o modelo</B><BR/>territorial con fuente>];
  }
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Advertir rezago o</B><BR/>serie descontinuada>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: indicador</B><BR/>trazable>];
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "BR" [color="#404040", style="solid", penwidth=1.1, label=< macro >, fontcolor="#262626"];
  "D1" -> "DN" [color="#404040", style="solid", penwidth=1.1, label=< pobreza >, fontcolor="#262626"];
  "D1" -> "TD" [color="#404040", style="solid", penwidth=1.1, label=< territorial >, fontcolor="#262626"];
  "D1" -> "BI" [color="#404040", style="solid", penwidth=1.1, label=< investigación >, fontcolor="#262626", minlen=2];
  "D1" -> "ED" [color="#404040", style="solid", penwidth=1.1, label=< educación >, fontcolor="#262626", minlen=2];
  "BR" -> "DV" [color="#404040", style="solid", penwidth=1.1];
  "BI" -> "DV" [color="#404040", style="solid", penwidth=1.1];
  "DN" -> "DV" [color="#404040", style="solid", penwidth=1.1];
  "TD" -> "DV" [color="#404040", style="solid", penwidth=1.1];
  "ED" -> "DV" [color="#404040", style="solid", penwidth=1.1];
  "DV" -> "AS" [color="#404040", style="solid", penwidth=1.1];
  "AS" -> "OUT" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "AS" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "E" -> "OUT" [color="#404040", style="solid", penwidth=1.1, label=< advertencia >, fontcolor="#262626"];
  "OUT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD></TD><TD></TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
}