digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Normativa y regulación</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D10</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Búsqueda</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Pregunta normativa</B><BR/>o vigilancia>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Tipo de norma?</B>>];
    "FP" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>funcion_publica_</B><BR/>norms_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "IM" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>imprenta_gaceta_</B><BR/>documents_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "DO" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>imprenta_diarios_</B><BR/>search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "SF" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>superfinanciera_</B><BR/>regulations · doctrine<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "CR" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>creg_acts_search</B><BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R08</I></FONT>>];
    "DI" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>dian_doctrina_search</B><BR/>en vivo<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "SC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>sic_normativa_</B><BR/>regulations · bulletins<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03 · R08</I></FONT>>];
    "F" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Acotar: tipo, número,</B><BR/>año, fechas, entidad<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R09</I></FONT>>];
  }
  subgraph cluster_1 {
    label=<<B>Lectura</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EBE9F3"; color="#8F85BE"; penwidth=1.0;
    "D3" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿capped o excesivo?</B>>];
    "D2" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Texto completo?</B>>];
    "PG" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Leer por rangos</B><BR/>(&gt; 1 M caracteres)<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R19</I></FONT>>];
    "G" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Grafo normativo:</B><BR/>amendments · norm_id>];
  }
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Afinar consulta</B><BR/>(too_many · capped)>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: norma vigente</B><BR/>con fuente>];
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "FP" [color="#404040", style="solid", penwidth=1.1, label=< administrativa >, fontcolor="#262626"];
  "D1" -> "IM" [color="#404040", style="solid", penwidth=1.1, label=< legislativa >, fontcolor="#262626"];
  "D1" -> "SF" [color="#404040", style="solid", penwidth=1.1, label=< financiera >, fontcolor="#262626"];
  "D1" -> "DI" [color="#404040", style="solid", penwidth=1.1, label=< tributaria >, fontcolor="#262626"];
  "D1" -> "DO" [color="#404040", style="solid", penwidth=1.1, label=< Diario Oficial >, fontcolor="#262626", minlen=2];
  "D1" -> "CR" [color="#404040", style="solid", penwidth=1.1, label=< energía >, fontcolor="#262626", minlen=2];
  "D1" -> "SC" [color="#404040", style="solid", penwidth=1.1, label=< SIC >, fontcolor="#262626", minlen=2];
  "FP" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "IM" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "DO" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "SF" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "CR" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "DI" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "SC" -> "F" [color="#404040", style="solid", penwidth=1.1];
  "F" -> "D3" [color="#404040", style="solid", penwidth=1.1];
  "D3" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< sí >, fontcolor="#D55E00"];
  "E" -> "F" [color="#404040", style="solid", penwidth=1.1, label=< reintentar >, fontcolor="#262626", constraint=false];
  "D3" -> "D2" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "D2" -> "PG" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D2" -> "G" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "PG" -> "G" [color="#404040", style="solid", penwidth=1.1, label=< <I>texto íntegro</I> >, fontcolor="#262626"];
  "G" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">dato (cursiva)</TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
}