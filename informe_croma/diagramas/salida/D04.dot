digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Empresas: RUES, Supersociedades, SIMEV y DIAN</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D04</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Identificación</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Contraparte</B><BR/>empresarial<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R11</I></FONT>>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Tienes NIT?</B>>];
    "RN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>rues_entities_by_name ·</B><BR/>secop_suppliers_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R03</I></FONT>>];
    "RU" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>rues_entity_by_nit</B><BR/>en vivo<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R10</I></FONT>>];
    "D2" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿found?</B>>];
  }
  subgraph cluster_1 {
    label=<<B>Profundización</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EEF8FD"; color="#A2D6F3"; penwidth=1.0;
    "D3" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Reporta a Supersociedades?</B>>];
    "SS" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>company · financial_</B><BR/>statements · filing_statements<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "OW" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>filing_ownership ·</B><BR/>ownership_search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "D4" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Emisor de valores?</B>>];
    "SV" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>simev_shareholders</B><BR/>cortes jun · dic<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "TR" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>dian_trade_profile</B><BR/>2017 en adelante<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
  }
  subgraph cluster_2 {
    label=<<B>Consolidación</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EBE9F3"; color="#8F85BE"; penwidth=1.0;
    "QC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Control de calidad</B><BR/>outliers · nulos · DV<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R09</I></FONT>>];
    "GR" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Ficha KYB + grafo</B><BR/>de vinculados>];
  }
  "NF" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>found:false:</B><BR/>verificar NIT y DV>];
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Dataset no disponible</B><BR/>→ reintentar>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: decisión</B><BR/>de vinculación>];
  "FER" [shape=ellipse, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Fin: corregir</B><BR/>o reintentar>];
  { rank=same; "S"; "D1"; }
  { rank=same; "RU"; "D2"; }
  { rank=same; "SS"; "OW"; }
  { rank=same; "D4"; "SV"; }
  { rank=same; "TR"; "QC"; }
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "RU" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D1" -> "RN" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "RN" -> "RU" [color="#332288", style="bold", penwidth=1.8, label=< remite a: NIT >, fontcolor="#332288", constraint=false];
  "RU" -> "D2" [color="#404040", style="solid", penwidth=1.1];
  "D2" -> "D3" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D2" -> "NF" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "D3" -> "SS" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D3" -> "D4" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "SS" -> "OW" [color="#404040", style="solid", penwidth=1.1];
  "SS" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< falla >, fontcolor="#D55E00"];
  "OW" -> "D4" [color="#404040", style="solid", penwidth=1.1];
  "D4" -> "SV" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D4" -> "TR" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "SV" -> "TR" [color="#404040", style="solid", penwidth=1.1];
  "TR" -> "QC" [color="#404040", style="solid", penwidth=1.1];
  "QC" -> "GR" [color="#404040", style="solid", penwidth=1.1];
  "GR" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "NF" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "E" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#332288"><B>——→</B></FONT></TD><TD ALIGN="LEFT">remite a</TD><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
  "FER" -> "__leyenda" [style=invis];
}