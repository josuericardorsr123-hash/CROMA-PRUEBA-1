digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Fuentes con sesión del titular y factura electrónica</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D09</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Entrada</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F1F7"; color="#73B1D5"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Registros propios o</B><BR/>validar una factura<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R11</I></FONT>>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Requiere sesión?</B>>];
  }
  subgraph cluster_1 {
    label=<<B>Factura</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "FE" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>dian_electronic_document</B><BR/>CUFE + NIT · caché 24 h<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R10 · R06</I></FONT>>];
    "PD" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿PDF protegido?</B>>];
    "PW" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Sugerir contraseñas</B><BR/>(NIT emisor sin DV…)>];
  }
  subgraph cluster_2 {
    label=<<B>Conexión</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E7F1EB"; color="#7CB48F"; penwidth=1.0;
    "C" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Conexión activa?</B>>];
    "CON" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#117733", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>*_connect: enlace</B><BR/>seguro · máx. 5<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R12 · R01</I></FONT>>];
    "Q" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>Facturas · exógena</B><BR/>cuentas · movimientos<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R02</I></FONT>>];
    "QC" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Conexión utilizable?</B>>];
    "J" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Trabajo asíncrono</B><BR/>no compartido<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R05</I></FONT>>];
  }
  "OUT" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Datos del titular</B><BR/>año cerrado>];
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>409 · 422 · 429</B><BR/>connections_*>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: información</B><BR/>del titular>];
  "FER" [shape=ellipse, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Fin: reconectar o</B><BR/>esperar cupo>];
  { rank=same; "S"; }
  { rank=same; "D1"; }
  { rank=same; "FE"; "C"; }
  { rank=same; "PD"; "CON"; }
  { rank=same; "PW"; "Q"; }
  { rank=same; "QC"; }
  { rank=same; "J"; "E"; }
  { rank=same; "OUT"; "FER"; }
  { rank=same; "FOK"; }
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "FE" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "D1" -> "C" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "FE" -> "PD" [color="#404040", style="solid", penwidth=1.1];
  "PD" -> "PW" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "PD" -> "OUT" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "C" -> "Q" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "C" -> "CON" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "CON" -> "Q" [color="#404040", style="solid", penwidth=1.1, label=< verificada >, fontcolor="#262626"];
  "Q" -> "QC" [color="#404040", style="solid", penwidth=1.1];
  "QC" -> "J" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "QC" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "J" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "OUT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "PW" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "E" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#117733"></TD><TD ALIGN="LEFT">Recurso de infraestructura</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
  "FER" -> "__leyenda" [style=invis];
}