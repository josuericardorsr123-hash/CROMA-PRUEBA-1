digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Verificación de personas naturales</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo con compuerta legal · v1.0 · 2026-10-12 · D07</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Compuerta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#FCF5E6"; color="#F1CA73"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Verificación de</B><BR/>una persona<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R10</I></FONT>>];
    "L" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Finalidad y base legal?</B>>];
  }
  subgraph cluster_1 {
    label=<<B>Consulta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "T" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Qué exige la finalidad?</B>>];
    "RG" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>registraduria_</B><BR/>vital_status<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "AN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>policía · procuraduría</B><BR/>contraloría · contaduría<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R05</I></FONT>>];
    "SG" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>adres · ruaf</B><BR/>(fecha expedición)<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R05</I></FONT>>];
    "SO" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>dnp_social_</B><BR/>classification<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "IP" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>sicaac · fiscalia_case</B><BR/>(21 dígitos)<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04 · R05</I></FONT>>];
    "RC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>registro_civil_</B><BR/>birth_record<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "J" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Trabajos asíncronos</B><BR/>MCP espera en línea<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R05 · R02</I></FONT>>];
  }
  subgraph cluster_2 {
    label=<<B>Evidencia</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EBE9F3"; color="#8F85BE"; penwidth=1.0;
    "V" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Resultado?</B>>];
    "NF" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>found:false</B><BR/>definitivo>];
    "VR" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Veredicto + frase</B><BR/>textual + fecha>];
    "EX" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Expediente con</B><BR/>minimización<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R11</I></FONT>>];
  }
  "NO" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>No consultar:</B><BR/>sin base legal>];
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>5xx · RUAF:</B><BR/>issue_date_matches>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: decisión</B><BR/>documentada>];
  "FER" [shape=ellipse, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Fin: abstención</B><BR/>o reintento>];
  { rank=same; "S"; }
  { rank=same; "L"; }
  { rank=same; "T"; "NO"; }
  { rank=same; "RG"; "AN"; "SG"; }
  { rank=same; "SO"; "IP"; "RC"; }
  { rank=same; "J"; }
  { rank=same; "V"; "E"; }
  { rank=same; "NF"; "VR"; "FER"; }
  { rank=same; "EX"; }
  { rank=same; "FOK"; }
  "S" -> "L" [color="#404040", style="solid", penwidth=1.1];
  "L" -> "T" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "L" -> "NO" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "T" -> "RG" [color="#404040", style="solid", penwidth=1.1, label=< identidad >, fontcolor="#262626"];
  "T" -> "AN" [color="#404040", style="solid", penwidth=1.1, label=< antecedentes >, fontcolor="#262626"];
  "T" -> "SG" [color="#404040", style="solid", penwidth=1.1, label=< seg. social >, fontcolor="#262626"];
  "T" -> "SO" [color="#404040", style="solid", penwidth=1.1, label=< Sisbén >, fontcolor="#262626", minlen=2];
  "T" -> "IP" [color="#404040", style="solid", penwidth=1.1, label=< insolvencia >, fontcolor="#262626", minlen=2];
  "T" -> "RC" [color="#404040", style="solid", penwidth=1.1, label=< reg. civil >, fontcolor="#262626", minlen=2];
  "RG" -> "V" [color="#404040", style="solid", penwidth=1.1];
  "SO" -> "V" [color="#404040", style="solid", penwidth=1.1];
  "RC" -> "V" [color="#404040", style="solid", penwidth=1.1];
  "AN" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "SG" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "IP" -> "J" [color="#404040", style="solid", penwidth=1.1];
  "J" -> "V" [color="#404040", style="solid", penwidth=1.1, label=< completed >, fontcolor="#262626"];
  "J" -> "E" [color="#D55E00", style="solid", penwidth=1.4, label=< falla >, fontcolor="#D55E00"];
  "V" -> "NF" [color="#404040", style="solid", penwidth=1.1, label=< no >, fontcolor="#262626"];
  "V" -> "VR" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "NF" -> "EX" [color="#404040", style="solid", penwidth=1.1];
  "VR" -> "EX" [color="#404040", style="solid", penwidth=1.1];
  "EX" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "NO" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "E" -> "FER" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD></TD><TD></TD><TD></TD><TD></TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
  "FER" -> "__leyenda" [style=invis];
}