digraph G {
  graph [fontname="Liberation Serif", fontsize=11.5, labelloc=t, labeljust=c, label=<<B>Croma × Colombia · Contratación pública: SECOP I y II y ANCP-CCE</B><BR/><FONT POINT-SIZE="9">Flujo de algoritmo · v1.0 · 2026-10-12 · D06</FONT>>,
         rankdir=TB, newrank=true, compound=true, nodesep=0.16, ranksep=0.30,
         splines=spline, pad=0.15, bgcolor="white"];
  node  [fontname="Liberation Serif", fontsize=10, style="filled", penwidth=0.9, margin="0.06,0.03"];
  edge  [fontname="Liberation Serif", fontsize=8.5, arrowsize=0.6];
  subgraph cluster_0 {
    label=<<B>Consulta</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#E6F5F1"; color="#73CAB2"; penwidth=1.0;
    "S" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Contratista, entidad,</B><BR/>objeto o id SECOP>];
    "D1" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Punto de partida?</B>>];
    "PF" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>secop_profile</B><BR/>1 llamada<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "PR" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>secop_processes_</B><BR/>search<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "D2" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿Formato del id?</B>>];
    "PA" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>secop_plans_search</B><BR/>Plan Anual<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "CC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>ancp_cce_conceptos_</B><BR/>search → concepto<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "RC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>*_record</B><BR/>milisegundos<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "LV" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>secop_process ·</B><BR/>secop_contract<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "D3" [shape=diamond, peripheries=1, style="filled", fillcolor="#E69F00", color="#1A1A1A", fontcolor="#000000", label=<<B>¿found?</B>>];
    "DP" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>contracts · awards ·</B><BR/>bidders · sanctions<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
  }
  subgraph cluster_1 {
    label=<<B>Análisis</B>>; fontsize=10; fontcolor="#1A1A1A"; labeljust=l;
    style="rounded,filled"; fillcolor="#EBE9F3"; color="#8F85BE"; penwidth=1.0;
    "QC" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Control de calidad</B><BR/>DV · pruebas · outliers<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R09</I></FONT>>];
    "OUT" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Perfil de riesgo o</B><BR/>inteligencia de mercado>];
  }
  "FB" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Vista viva sin el</B><BR/>registro (T44)>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: hallazgo</B><BR/>trazable>];
  "S" -> "D1" [color="#404040", style="solid", penwidth=1.1];
  "D1" -> "PF" [color="#404040", style="solid", penwidth=1.1, label=< documento >, fontcolor="#262626"];
  "D1" -> "PR" [color="#404040", style="solid", penwidth=1.1, label=< texto >, fontcolor="#262626"];
  "D1" -> "D2" [color="#404040", style="solid", penwidth=1.1, label=< id >, fontcolor="#262626"];
  "D1" -> "PA" [color="#404040", style="solid", penwidth=1.1, label=< plan >, fontcolor="#262626", minlen=2];
  "D1" -> "CC" [color="#404040", style="solid", penwidth=1.1, label=< concepto >, fontcolor="#262626", minlen=2];
  "PR" -> "RC" [color="#332288", style="bold", penwidth=1.8, label=< remite a >, fontcolor="#332288", constraint=false];
  "D2" -> "RC" [color="#404040", style="solid", penwidth=1.1, label=< secop_ii:… >, fontcolor="#262626"];
  "D2" -> "LV" [color="#404040", style="solid", penwidth=1.1, label=< CO1.… >, fontcolor="#262626"];
  "LV" -> "D3" [color="#404040", style="solid", penwidth=1.1];
  "D3" -> "QC" [color="#404040", style="solid", penwidth=1.1, label=< sí >, fontcolor="#262626"];
  "D3" -> "FB" [color="#D55E00", style="solid", penwidth=1.4, label=< no >, fontcolor="#D55E00"];
  "FB" -> "RC" [color="#332288", style="bold", penwidth=1.8, label=< remite a >, fontcolor="#332288", constraint=false];
  "PF" -> "DP" [color="#404040", style="solid", penwidth=1.1];
  "DP" -> "QC" [color="#404040", style="solid", penwidth=1.1];
  "RC" -> "QC" [color="#404040", style="solid", penwidth=1.1];
  "PA" -> "QC" [color="#404040", style="solid", penwidth=1.1];
  "QC" -> "OUT" [color="#404040", style="solid", penwidth=1.1];
  "CC" -> "OUT" [color="#404040", style="solid", penwidth=1.1, label=< <I>criterio</I> >, fontcolor="#262626"];
  "OUT" -> "FOK" [color="#404040", style="solid", penwidth=1.1];
  "__leyenda" [shape=plain, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Leyenda</B> <FONT COLOR="#4D4D4D"><I>· formas: óvalo inicio/fin · rombo decisión · rectángulo proceso · paralelogramo E/S · cilindro datos · rec. Rxx = recursos</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#0072B2"></TD><TD ALIGN="LEFT">Entrada / salida</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#E69F00"></TD><TD ALIGN="LEFT">Decisión</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#009E73"></TD><TD ALIGN="LEFT">Proceso / herramienta</TD></TR><TR><TD WIDTH="16" HEIGHT="10" BGCOLOR="#332288"></TD><TD ALIGN="LEFT">Control / orquestación</TD><TD WIDTH="16" HEIGHT="10" BGCOLOR="#D55E00"></TD><TD ALIGN="LEFT">Error / contingencia</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">flujo</TD></TR><TR><TD ALIGN="CENTER"><FONT COLOR="#332288"><B>——→</B></FONT></TD><TD ALIGN="LEFT">remite a</TD><TD ALIGN="CENTER"><FONT COLOR="#D55E00">——→</FONT></TD><TD ALIGN="LEFT">ruta de error</TD><TD ALIGN="CENTER"><FONT COLOR="#404040">——→</FONT></TD><TD ALIGN="LEFT">dato (cursiva)</TD></TR></TABLE></TD></TR></TABLE>>];
  "FOK" -> "__leyenda" [style=invis];
}