    "SM" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>samai_rulings_search</B><BR/>headnotes · tesis<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R03</I></FONT>>];
    "CN" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>cndj_rulings_search</B><BR/>en vivo<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R04</I></FONT>>];
    "F" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Acotar: tipo, año,</B><BR/>fechas, ponente<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R09</I></FONT>>];
  }
