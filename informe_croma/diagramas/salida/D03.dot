    "DET" [shape=box, peripheries=1, style="filled,rounded", fillcolor="#009E73", color="#1A1A1A", fontcolor="#000000", label=<<B>Detalle de la</B><BR/>providencia<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R08</I></FONT>>];
    "PAG" [shape=box, peripheries=2, style="filled,rounded", fillcolor="#332288", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Leer por rangos</B><BR/>offset · limit<BR/><FONT POINT-SIZE="7" COLOR="#FFFFFF"><I>rec. R19</I></FONT>>];
    "RS" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Número, fecha, ponente,</B><BR/>decisión, enlace>];
  }
  "E" [shape=parallelogram, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>5xx · job_failed ·</B><BR/>texto sin paginar<BR/><FONT POINT-SIZE="7" COLOR="#000000"><I>rec. R09</I></FONT>>];
  "FOK" [shape=ellipse, peripheries=1, style="filled", fillcolor="#0072B2", color="#1A1A1A", fontcolor="#FFFFFF", label=<<B>Fin: cita</B><BR/>verificable>];
  "FER" [shape=ellipse, peripheries=1, style="filled", fillcolor="#D55E00", color="#1A1A1A", fontcolor="#000000", label=<<B>Fin: reintentar</B><BR/>o acotar>];
