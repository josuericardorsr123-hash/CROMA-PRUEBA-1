# ─── Expediente Maleable · configuración (copie a .env y complete) ───────────
# Ningún secreto se versiona. En producción (NODE_ENV=production) son
# obligatorios EM_CLAVE_MAESTRA y EM_JWT_SECRETO.

NODE_ENV=production
PORT=8080

# ── Proveedores ──────────────────────────────────────────────────────────────
# Proveedor de IA: anthropic (API, por defecto) o claude-code (sesión de Claude Code del
# usuario; SOLO uso personal y local, nunca en un servidor que atienda a terceros).
EM_PROVEEDOR_IA=anthropic
# Claude (API de Anthropic). Sin clave, los nodos de IA se detienen con error explicativo.
ANTHROPIC_API_KEY=
# Solo con EM_PROVEEDOR_IA=claude-code: ejecutable y tiempo máximo por llamada.
EM_CLAUDE_COMANDO=claude
EM_CLAUDE_TIMEOUT_MS=1200000
# Modelo (por defecto claude-opus-5) y fallback del lado servidor ante rechazo (1 = activo).
EM_MODELO=
EM_FALLBACKS=1

# Croma (MCP, Streamable HTTP + Bearer): https://usecroma.com
CROMA_API_KEY=
CROMA_MCP_URL=https://api.croma.run/mcp
CROMA_TIMEOUT_MS=60000
CROMA_CONCURRENCIA=4
# Mapeo explícito capacidad → herramienta, si el descubrimiento automático no basta:
# CROMA_MAPEO_JSON={"empresas.rues":{"herramienta":"rues_consultar_nit","argumentos":{"nit":"nit"}}}
CROMA_MAPEO_JSON=
# Lectura directa de portales oficiales cuando Croma no trae el texto (0 = desactivada).
EM_HTTP_OFICIAL=1

# ── Persistencia y cifrado ───────────────────────────────────────────────────
# sqlite:ruta.db | postgres://usuario:clave@host:5432/base
EM_BASE_DATOS=
EM_DIR_DATOS=/datos
# Clave maestra AES-256 (32 bytes en base64 o hex): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EM_CLAVE_MAESTRA=
EM_CLAVE_ID=k1
# Rotación: claves anteriores para descifrar lo ya guardado ("k0:base64,…").
EM_CLAVES_ANTERIORES=
# Clave de PostgreSQL para docker-compose.
EM_PG_CLAVE=

# ── API ──────────────────────────────────────────────────────────────────────
# Secreto de sesión (≥ 32 caracteres).
EM_JWT_SECRETO=
EM_SESION_MINUTOS=480
EM_LIMITE_MINUTO=300
EM_MAX_ARCHIVO_MB=200
EM_CONFIAR_PROXY=0
# 0 = esta réplica solo atiende la API (el trabajo lo hace otra réplica).
EM_TRABAJADOR=1
EM_CONCURRENCIA_TRABAJOS=2
EM_NIVEL_LOG=info

# ── Despacho y entregables ───────────────────────────────────────────────────
EM_AUTOR_INFORME=Josué Ricardo Rojas Silva
EM_CARGO_AUTOR=
# Primera parte del encabezado editorial (revista/blog); se completa con categoría y fecha.
EM_PUBLICACION=Expediente Maleable · Informe técnico
EM_CIUDAD=Bogotá D.C.
# Textos literales del despacho (véase config/perfil-despacho.ejemplo.json).
EM_PERFIL_DESPACHO=
# Repositorio normativo local (JSONL importado con: em repositorio importar --skill …).
EM_REPOSITORIO_JSONL=
EM_FRESCURA_DIAS=180
# SMMLV de años no incluidos en el catálogo, verificados en el decreto oficial (formato AÑO=VALOR,AÑO=VALOR):
SMMLV_AJUSTES=

# Cierres extraordinarios de despachos o suspensión de términos (AAAA-MM-DD, separados por comas).
# La vacancia colectiva (20 dic. a 10 ene.) y la de Semana Santa ya están incluidas.
EM_CIERRES_JUDICIALES=
EM_DIAS_HABILITADOS=

# ── Pipeline ─────────────────────────────────────────────────────────────────
EM_MAX_ITER_CITAS=2
EM_MAX_ITER_REVISION=6
EM_CONCURRENCIA_PIPELINE=4
EM_DPI_LECTURA=150
EM_MAX_PAGINAS_ARCHIVO=2000
# Paginación real de la TABLA DE CONTENIDO con LibreOffice (1/0; por defecto, si está instalado).
EM_PAGINAR_INFORME=

# ── Demostración (nunca en producción) ───────────────────────────────────────
# EM_MODO=demostracion levanta la API con Croma simulado, IA de demostración y un usuario ficticio.
EM_MODO=
EM_CLAVE_DEMO=
